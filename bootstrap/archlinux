#!/usr/bin/env bash
# booty bootstrap
set -eo pipefail

script_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
profile_dir="$(cd "$script_dir/../profiles/archlinux" && pwd)"
config_yaml="$profile_dir/config.yaml"

# shellcheck source=bootstrap/lib/common.sh
. "$script_dir/lib/common.sh"
# shellcheck source=bootstrap/lib/yaml.sh
. "$script_dir/lib/yaml.sh"

pkg(){ pacman -S --noconfirm --needed "$@"; }
bootstrap_packages=(
  ca-certificates
  curl
  git
  gnupg
  go-yq
)

# shellcheck source=/etc/os-release
. /etc/os-release
[ "${ID:-}" = "arch" ] || die "This bootstrap currently expects Arch Linux."
[ "$EUID" -eq 0 ] || die "Please execute as superuser."

pkg "${bootstrap_packages[@]}"
yq --version 2>/dev/null | grep -qi mikefarah || die "booty expects Mike Farah yq (Arch package: go-yq)."

run_source_dir "$script_dir/archlinux.d"
