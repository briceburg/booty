log "configuring user: $user"
id -u "$user" &>/dev/null || {
  useradd --create-home "$user"
  passwd -l "$user" >/dev/null
}
usermod -aG docker,log,libvirt,rfkill,video,uucp,wheel "$user"

grep -qF "/usr/bin/pacman" "/etc/sudoers.d/user-$user" 2>/dev/null || cat << EOF >> "/etc/sudoers.d/user-$user"
$user ALL=(ALL:ALL) NOPASSWD: /usr/bin/makepkg
$user ALL=(ALL:ALL) NOPASSWD: /usr/bin/pacman
EOF

# apply home files, AUR packages, and user hooks in the user's login shell
# aur-install comes from the root tree via 40-root-files
sudo --login -u "$user" \
  env \
    BOOTY_AUR_PACKAGES="${selected_aur[*]:-}" \
    BOOTY_REPO_ROOT="$repo_root" \
    BOOTY_USER_BOOTSTRAP_DIR="$profile_dir/users/$user/bootstrap.d" \
    bash -s << 'BOOTSTRAP'
  set -euo pipefail

  . "$BOOTY_REPO_ROOT/bootstrap/lib/common.sh"

  mkdir -p "$HOME/"{git/AUR,bin,tmp}

  booty pull

  if [ -n "${BOOTY_AUR_PACKAGES:-}" ]; then
    # split the configured AUR package list into positional args
    set -- $BOOTY_AUR_PACKAGES
    aur-install "$@"
  fi

  run_source_dir "$BOOTY_USER_BOOTSTRAP_DIR"
BOOTSTRAP
