#!/usr/bin/env bash
# booty managed
set -eo pipefail

log(){ echo "$*" >&2; }
die(){ log "$*"; exit 1; }
repo_dir="$HOME/git/AUR"

command -v makepkg >/dev/null || die "makepkg is required"
[ "$EUID" -eq 0 ] && die "cannot execute as superuser"
[ -d "$repo_dir" ] || die "missing $repo_dir - has user bootstrap run?"

for i in "$@"; do
  (
    cd "$repo_dir"
    [ -d "$i" ] || git clone "https://aur.archlinux.org/$i.git"
    git -C "$i" pull
    cd "$i"
    makepkg -si --noconfirm --needed
  )
done
