#!/usr/bin/env bash
set -eo pipefail

. "$(dirname "$(readlink -f "$0")")/../lib/booty.sh"

[ "$BOOTY_USER" != root ] ||
  die "run booty as your regular user; booty uses sudo only for protected system files"

case "${1:-status}" in
  -h|--help|help)
    cat <<EOF
usage: booty <command> [args]

commands: pull apply status diff add rm mv commit setup gpg
git commands: branch config remote log show fetch tag push

Use 'booty-secrets <command>' to operate on the secrets checkout.
EOF
    ;;
  setup)
    booty_setup
    ;;
  gpg)
    shift
    booty_gpg "$@"
    ;;
  bootstrap)
    die "use 'booty setup' for repo setup; use 'booty-bootstrap' for OS bootstrap"
    ;;
  *)
    if [ -n "$BOOTY_SECRETS" ]; then
      repo="$booty_secrets_repo"
      export BOOTY_MANIFEST_PREFIX=secrets
      [ -d "$repo/.git" ] || die "missing secrets checkout: $repo; run 'booty setup'"
    else
      repo="$booty_repo"
      [ -d "$repo/.git" ] || die "missing public checkout: $repo; run install or clone your repo there"
    fi
    booty_run "$repo" "${1:-status}" "${@:2}"
    ;;
esac
