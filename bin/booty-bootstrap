#!/usr/bin/env bash
set -eo pipefail

. "$(dirname "$(readlink -f "$0")")/../lib/booty.sh"
source_file "$BOOTY_ROOT/lib/booty-bootstrap.sh"

cmd="${1:-bootstrap}"

case "$cmd" in
  help|--help|-h)
    cat <<EOF
usage: booty-bootstrap [bootstrap|config|help]

Bootstraps this machine with $BOOTSTRAP_ROOT.
BOOTSTRAP_USER selects the dotfile/OS user.
BOOTY_REPO_URL is required unless user config defines repo_url.
EOF
    exit 0
    ;;
  bootstrap|config) ;;
  *) die "usage: booty-bootstrap [bootstrap|config|help]" ;;
esac

export BOOTSTRAP_CMD="$cmd"
[ -n "${BOOTSTRAP_USER:-}" ] || [ "$EUID" -eq 0 ] || export BOOTSTRAP_USER="$BOOTY_USER"

[ "$BOOTSTRAP_CMD" != bootstrap ] || [ "$EUID" -eq 0 ] || sudo_env_exec "${BOOTSTRAP_ENV[@]}" -- "$0" "$@"

if [ "$BOOTSTRAP_CMD" = config ]; then
  config_script="$BOOTSTRAP_ROOT/00-config.sh"
  [ -f "$config_script" ] || die "missing bootstrap config script: $config_script"
  source_file "$config_script"
  bootstrap_dump_env
  exit 0
fi

scripts=("$BOOTSTRAP_ROOT"/[0-9][0-9]-*.sh)
[ -f "${scripts[0]}" ] || die "missing bootstrap scripts: $BOOTSTRAP_ROOT"

for script in "${scripts[@]}"; do
  source_bootstrap "$script"
  bootstrap_apply_rootfs
done

[ "${BOOTSTRAP_TARGET_READY:-0}" = 1 ] || die "bootstrap scripts did not prepare target checkout"
bootstrap_apply_rootfs

script="$BOOTSTRAP_ROOT/users/$BOOTSTRAP_USER.sh"
[ ! -f "$script" ] || {
  log "running ${script#"$BOOTSTRAP_ROOT/"}"
  as_user "$BOOTSTRAP_USER" bash "$script"
}

source_bootstrap "$BOOTSTRAP_ROOT/hosts/$BOOTY_HOST.sh"

log "running booty sync as $BOOTSTRAP_USER"
BOOTY_SKIP_ROOTFS=1 as_user "$BOOTSTRAP_USER" "$BOOTY_HOME/booty/bin/booty" sync
log "[OK] Bootstrap Complete"
