#!/usr/bin/env bash
set -eo pipefail

export BOOTY_CI="${BOOTY_CI:-lint bats}"
export DEBUG="${DEBUG:-0}"
export RUFF_CACHE_DIR="${RUFF_CACHE_DIR:-/tmp/booty-ruff-cache}"

on_exit() {
  local status="$1"
  if [ "$status" -eq 0 ]; then
    echo "✅ CI checks passed" >&2
  else
    echo "❌ CI checks failed" >&2
  fi
}

[ "${BOOTY_CI_CONTAINER:-0}" = 1 ] || trap 'on_exit "$?"' EXIT

test/lint() {
  local file
  local candidates=()
  local python_files=()
  local shell_files=()
  echo "==> running linters" >&2
  mapfile -t candidates < <(
    {
      find bin -type f
      find bootstrap -type f \( -name '*.sh' -o -perm -111 \)
      find dotfiles -type f -perm -111
      printf '%s\n' install tests/test_helper.bash
      find tests/helpers -type f -perm -111
      find tests/archlinux -type f -name '*.sh'
      find tests/fixtures -type f \( -name '*.sh' -o -perm -111 \)
    } | sort -u
  )
  for file in "${candidates[@]}"; do
    case "$(head -n 1 "$file")" in
      *bash*|*sh*) shell_files+=("$file") ;;
      *python*) python_files+=("$file") ;;
    esac
  done
  shellcheck -x -s bash -P SCRIPTDIR "${shell_files[@]}"
  if [ "${#python_files[@]}" -gt 0 ]; then
    ruff check "${python_files[@]}"
    ruff format --check "${python_files[@]}"
  fi
}

test/bats() {
  local bats_flags=()
  echo "==> running bats tests" >&2
  [ "$DEBUG" != 1 ] || bats_flags+=(--print-output-on-failure --trace)
  bats "${bats_flags[@]}" tests
}

test/archlinux() {
  local image="${BOOTSTRAP_ARCHLINUX_IMAGE:-archlinux:latest}"
  echo "==> archlinux bootstrap simulation (image: $image)" >&2
  docker run --rm -i \
    --volume "$PWD:/work:ro" \
    -e DEBUG \
    "$image" \
    bash /work/tests/archlinux/simulate-bootstrap.sh
}

if [ "${BOOTY_CI_CONTAINER:-0}" = 1 ]; then
  for suite in $BOOTY_CI; do "test/$suite"; done
  exit 0
fi

cd "$(dirname "$0")/.." || exit 1
ci_suites=()
for suite in $BOOTY_CI; do
  case "$suite" in
    lint|bats) ci_suites+=("$suite") ;;
    archlinux) test/archlinux ;;
    *) echo "unknown BOOTY_CI suite: $suite" >&2; exit 2 ;;
  esac
done

if [ "${#ci_suites[@]}" -gt 0 ]; then
  docker build -f Dockerfile.ci -t booty-ci .
  BOOTY_CI="${ci_suites[*]}" docker run --rm \
    -e BOOTY_CI_CONTAINER=1 \
    -e BOOTY_CI \
    -e DEBUG \
    -v "$PWD:/work" \
    booty-ci ./bin/ci
fi
