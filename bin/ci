#!/usr/bin/env bash
set -eo pipefail

on_exit() {
  local status="$1"
  [ "$status" -eq 0 ] &&
    echo "✅ CI checks passed" >&2 ||
    echo "❌ CI checks failed" >&2
}

cd "$(dirname "$0")/.." || exit 1
trap 'on_exit "$?"' EXIT

if [ "${BOOTY_CI:-0}" != "1" ]; then
  docker build -f Dockerfile.ci -t booty-ci .
  docker run --rm -e BOOTY_CI=1 -v "$PWD:/work" booty-ci ./bin/ci
  bash tests/archlinux/simulate-bootstrap.sh
  exit 0
fi

shell_files=()
while IFS= read -r file; do
  shell_files+=("$file")
done < <(
  {
    find bin lib -type f
    find bootstrap -type f \( -name '*.sh' -o -perm -111 \)
    find dotfiles -type f -perm -111
    printf '%s\n' tests/test_helper.bash
    find tests/helpers -type f -perm -111
    find tests/archlinux -type f -name '*.sh'
  } | sort -u
)

shellcheck -x -s bash -P SCRIPTDIR "${shell_files[@]}"
bats tests
