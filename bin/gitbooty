#!/usr/bin/env bash
set -eo pipefail

log(){ echo "$*" >&2 ; }
die(){ log "$*"; exit 1; }

render_tmp=""
layers=()
excludes=()

repo_root="${GITBOOTY_REPO_ROOT:-}"
writeback_root="${GITBOOTY_WRITEBACK_ROOT:-}"
target_root="${GITBOOTY_TARGET_ROOT:-}"
manifest="${GITBOOTY_MANIFEST:-}"

read_env_lines(){
  local var="$1" line
  local -n out="$2"
  while IFS= read -r line; do
    [ -z "$line" ] || out+=("$line")
  done <<< "${!var:-}"
}

read_env_lines GITBOOTY_LAYERS layers
read_env_lines GITBOOTY_EXCLUDES excludes

usage() {
  cat <<'EOF'
usage: gitbooty <command> [args]

commands: apply pull status diff add rm mv commit
git commands: branch config remote log show fetch tag push
env: GITBOOTY_REPO_ROOT GITBOOTY_WRITEBACK_ROOT GITBOOTY_TARGET_ROOT GITBOOTY_MANIFEST GITBOOTY_LAYERS
EOF
}

ensure_data_dir() {
  mkdir -p "$(dirname "$manifest")"
}

repo_git() {
  git -C "$repo_root" "$@"
}

cleanup_render_index() {
  [ -n "$render_tmp" ] && rm -rf "$render_tmp"
  return 0
}

require_manifest() {
  [ -f "$manifest" ] || die "no manifest; run 'pull' first"
}

canonicalize_target() {
  local path="$1"
  case "$path" in
    /*) printf '%s\n' "$path" ;;
    \~) printf '%s\n' "$HOME" ;;
    \~/*) printf '%s/%s\n' "$HOME" "${path#\~/}" ;;
    *) printf '%s\n' "$PWD/$path" ;;
  esac
}

relative_target() {
  local abs="$1"
  case "$target_root" in
    /)
      case "$abs" in
        /*) printf '%s\n' "${abs#/}" ;;
        *) die "path '$abs' is not absolute" ;;
      esac
      ;;
    *)
      case "$abs" in
        "$target_root"/*) printf '%s\n' "${abs#"$target_root"/}" ;;
        "$target_root") printf '\n' ;;
        *) die "path '$abs' is outside $target_root" ;;
      esac
      ;;
  esac
}

infer_source_rel() {
  local rel="$1"
  local abs="$writeback_root/$rel"
  case "$abs" in
    "$repo_root"/*) printf '%s\n' "${abs#"$repo_root"/}" ;;
    *) printf '%s\n' "$abs" ;;
  esac
}

manifest_source_rel() {
  local rel="$1"
  awk -F '\t' -v rel="$rel" '$1 == rel { print $2 }' "$manifest"
}

build_manifest() {
  local output="$1"
  local -A mapping=()
  local layer file rel source_rel

  : > "$output"
  for layer in "${layers[@]}"; do
    [ -d "$layer" ] || continue
    while IFS= read -r file; do
      rel="${file#"$layer"/}"
      excluded "$rel" && continue
      case "$file" in
        "$repo_root"/*) source_rel="${file#"$repo_root"/}" ;;
        *) source_rel="$file" ;;
      esac
      mapping["$rel"]="$source_rel"
    done < <(find_layer "$layer" | sort)
  done

  for rel in "${!mapping[@]}"; do
    printf '%s\t%s\n' "$rel" "${mapping[$rel]}"
  done | sort > "$output"
}

find_layer() {
  local layer="$1" pattern prune=()
  for pattern in "${excludes[@]}"; do
    case "$pattern" in
      */*) prune+=(-path "$layer/${pattern%/*}" -prune -o) ;;
    esac
  done
  find "$layer" "${prune[@]}" \( -type f -o -type l \) -print
}

excluded() {
  local rel="$1" pattern
  for pattern in "${excludes[@]}"; do
    # shellcheck disable=SC2053 # exclude patterns are shell globs
    [[ "$rel" == $pattern ]] && return 0
  done
  return 1
}

source_path() {
  local rel="$1"
  case "$rel" in
    /*) printf '%s\n' "$rel" ;;
    *) printf '%s\n' "$repo_root/$rel" ;;
  esac
}

source_git_mode() {
  local src="$1"
  if [ -L "$src" ]; then
    printf '120000\n'
  elif [ -x "$src" ]; then
    printf '100755\n'
  else
    printf '100644\n'
  fi
}

hash_source_object() {
  local src="$1"
  local link_target
  if [ -L "$src" ]; then
    link_target="$(readlink "$src")"
    printf '%s' "$link_target" | git --git-dir "$render_tmp/repo/.git" hash-object -w --stdin
  else
    git --git-dir "$render_tmp/repo/.git" hash-object -w -- "$src"
  fi
}

copy_target_to_source() {
  local src="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"
  rm -f "$dst"
  cp -a -- "$src" "$dst"
}

drop_manifest_rel() {
  local rel="$1"
  [ -f "$manifest" ] || return 0
  awk -F '\t' -v rel="$rel" '$1 != rel' "$manifest" > "$manifest.tmp"
  mv "$manifest.tmp" "$manifest"
}

init_render_index() {
  local manifest_file="$1"
  local rel source_rel src mode blob

  cleanup_render_index
  render_tmp="$(mktemp -d "${TMPDIR:-/tmp}/gitbooty.XXXXXX")"
  git init -q "$render_tmp/repo"

  GIT_INDEX_FILE="$render_tmp/index" git --git-dir "$render_tmp/repo/.git" read-tree --empty

  while IFS=$'\t' read -r rel source_rel; do
    [ -n "$rel" ] || continue
    src="$(source_path "$source_rel")"
    [ -f "$src" ] || [ -L "$src" ] || die "managed source '$source_rel' is missing"
    mode="$(source_git_mode "$src")"
    blob="$(hash_source_object "$src")"
    printf '%s %s\t%s\n' "$mode" "$blob" "$rel"
  done < "$manifest_file" |
    GIT_INDEX_FILE="$render_tmp/index" git --git-dir "$render_tmp/repo/.git" update-index --index-info
}

render_git() {
  GIT_INDEX_FILE="$render_tmp/index" GIT_WORK_TREE="$target_root" git --git-dir "$render_tmp/repo/.git" "$@"
}

prune_manifest_removals() {
  local next_manifest="$1"
  [ -f "$manifest" ] || return 0
  awk -F '\t' 'FILENAME == ARGV[1] { keep[$1]=1; next } $1 && !($1 in keep) { print $1 }' "$next_manifest" "$manifest" |
    while IFS= read -r rel; do rm -f -- "$target_root/$rel"; done
}

status_cmd() {
  require_manifest
  init_render_index "$manifest"
  render_git update-index --refresh -q >/dev/null 2>&1 || true
  render_git diff-files --name-status
  if repo_git rev-parse --git-dir >/dev/null 2>&1; then
    repo_git status --short
  fi
  render_git diff-files --quiet
}

diff_cmd() {
  require_manifest
  init_render_index "$manifest"
  render_git update-index --refresh -q >/dev/null 2>&1 || true
  render_git diff --no-ext-diff --src-prefix=booty/ --dst-prefix=target/ || true
}

add_cmd() {
  local abs rel source_rel dest
  [ $# -eq 1 ] || die "usage: gitbooty add <path>"
  abs="$(canonicalize_target "$1")"
  [ -e "$abs" ] || die "path '$abs' does not exist"
  rel="$(relative_target "$abs")"
  source_rel="$(infer_source_rel "$rel")"
  dest="$(source_path "$source_rel")"
  copy_target_to_source "$abs" "$dest"
  repo_git add "$source_rel"
  ensure_data_dir
  drop_manifest_rel "$rel"
  printf '%s\t%s\n' "$rel" "$source_rel" >> "$manifest"
  sort -o "$manifest" "$manifest"
}

rm_cmd() {
  local abs rel source_rel src
  [ $# -gt 0 ] || die "usage: gitbooty rm <path>..."
  ensure_data_dir
  require_manifest

  for abs in "$@"; do
    abs="$(canonicalize_target "$abs")"
    rel="$(relative_target "$abs")"
    [ -n "$rel" ] || die "refusing to remove target root"
    source_rel="$(manifest_source_rel "$rel")"
    [ -n "$source_rel" ] || die "path '$abs' is not tracked"
    src="$(source_path "$source_rel")"
    rm -f -- "$abs"
    if [ -e "$src" ] || [ -L "$src" ]; then
      repo_git rm -f --ignore-unmatch -- "$source_rel"
      rm -f -- "$src"
    fi
    drop_manifest_rel "$rel"
  done
}

mv_cmd() {
  local src_abs dst_abs src_rel dst_rel source_rel source dest_rel dest
  [ $# -eq 2 ] || die "usage: gitbooty mv <src> <dst>"
  src_abs="$(canonicalize_target "$1")"
  dst_abs="$(canonicalize_target "$2")"
  src_rel="$(relative_target "$src_abs")"
  dst_rel="$(relative_target "$dst_abs")"
  [ -e "$src_abs" ] || [ -L "$src_abs" ] || die "path '$src_abs' does not exist"
  source_rel=""
  [ -f "$manifest" ] && source_rel="$(manifest_source_rel "$src_rel")"
  [ -n "$source_rel" ] || die "path '$src_abs' is not tracked; use 'add' for new files"
  source="$(source_path "$source_rel")"
  dest_rel="$(infer_source_rel "$dst_rel")"
  dest="$(source_path "$dest_rel")"
  if [ -e "$source" ] || [ -L "$source" ]; then
    mkdir -p "$(dirname "$dst_abs")"
    mv "$src_abs" "$dst_abs"
    mkdir -p "$(dirname "$dest")"
    mv "$source" "$dest"
    repo_git rm -f --ignore-unmatch -- "$source_rel"
    repo_git add -- "$dest_rel"
    awk -F '\t' -v src="$src_rel" -v dst="$dst_rel" -v newrel="$dest_rel" 'BEGIN { OFS="\t" } $1 == src { $1=dst; $2=newrel } { print }' "$manifest" > "$manifest.tmp"
    mv "$manifest.tmp" "$manifest"
  else
    die "tracked source '$source_rel' is missing from the repo"
  fi
}

sync_manifest_to_source() {
  local rel source_rel src dst
  [ -f "$manifest" ] || return 0
  while IFS=$'\t' read -r rel source_rel; do
    [ -n "$rel" ] || continue
    src="$target_root/$rel"
    dst="$(source_path "$source_rel")"
    if [ -e "$src" ] || [ -L "$src" ]; then
      copy_target_to_source "$src" "$dst"
      repo_git add "$source_rel"
    elif [ -e "$dst" ]; then
      repo_git rm -f -- "$source_rel"
    fi
  done < "$manifest"
}

commit_cmd() {
  sync_manifest_to_source
  repo_git commit "$@"
}


pull_cmd() {
  if repo_git remote get-url origin >/dev/null 2>&1; then
    repo_git pull --ff-only
  fi
  apply_cmd
}

apply_cmd() {
  local next_manifest="${manifest}.next"
  local prefix="${target_root%/}/"

  ensure_data_dir
  build_manifest "$next_manifest"
  prune_manifest_removals "$next_manifest"
  mv "$next_manifest" "$manifest"
  mkdir -p "$target_root"
  init_render_index "$manifest"
  render_git checkout-index -f -a --prefix="$prefix"
}

case "${1:-help}" in
  -h|--help|help) usage; exit 0 ;;
esac
[ -n "$repo_root" ] || die "GITBOOTY_REPO_ROOT is required"
[ -n "$writeback_root" ] || die "GITBOOTY_WRITEBACK_ROOT is required"
[ -n "$target_root" ] || die "GITBOOTY_TARGET_ROOT is required"
[ -n "$manifest" ] || die "GITBOOTY_MANIFEST is required"
((${#layers[@]})) || die "GITBOOTY_LAYERS is required"
trap cleanup_render_index EXIT
case "$1" in
  apply|pull|status|diff|add|rm|mv|commit) "${1}_cmd" "${@:2}" ;;
  branch|config|remote|log|show|fetch|tag|push) repo_git "$@" ;;
  *) usage; die "unsupported command '$1'" ;;
esac
