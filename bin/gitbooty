#!/usr/bin/env bash
set -euo pipefail

log(){ echo "$*" >&2 ; }
die(){ log "$*"; exit 1; }

repo_root=""
writeback_root=""
target_root=""
manifest=""
declare -a layers=()
cmd=""
declare -a cmd_args=()

usage() {
  cat <<'EOF'
usage: gitbooty [options] <command> [args]

commands:
  pull
  status
  diff
  add <path>
  mv <src> <dst>
  commit [git-commit-args...]
  push [git-push-args...]

options:
  --repo-root <path>
  --writeback-root <path>
  --target-root <path>
  --manifest <path>
  --layer <path>        may be specified multiple times
  -h, --help
EOF
}

parse_args() {
  [ $# -gt 0 ] || {
    usage
    exit 0
  }

  while (($#)); do
    case "$1" in
      -h|--help)
        usage
        exit 0
        ;;
      --repo-root) repo_root="$2"; shift 2 ;;
      --writeback-root) writeback_root="$2"; shift 2 ;;
      --target-root) target_root="$2"; shift 2 ;;
      --manifest) manifest="$2"; shift 2 ;;
      --layer) layers+=("$2"); shift 2 ;;
      --) shift; break ;;
      pull|status|diff|add|mv|commit|push) break ;;
      *) die "unsupported option '$1'" ;;
    esac
  done

  cmd="${1:-status}"
  shift || true
  cmd_args=("$@")

  [ -n "$repo_root" ] || { usage; die "--repo-root is required"; }
  [ -n "$writeback_root" ] || { usage; die "--writeback-root is required"; }
  [ -n "$target_root" ] || { usage; die "--target-root is required"; }
  [ -n "$manifest" ] || { usage; die "--manifest is required"; }
  ((${#layers[@]})) || { usage; die "at least one --layer is required"; }
}

ensure_data_dir() {
  mkdir -p "$(dirname "$manifest")"
}

repo_git() {
  git -C "$repo_root" "$@"
}

require_manifest() {
  [ -f "$manifest" ] || die "no manifest; run 'pull' first"
}

canonicalize_target() {
  local path="$1"
  case "$path" in
    /*) printf '%s\n' "$path" ;;
    ~*) eval "printf '%s\n' $path" ;;
    *) printf '%s\n' "$PWD/$path" ;;
  esac
}

relative_target() {
  local abs="$1"
  case "$target_root" in
    /)
      case "$abs" in
        /*) printf '%s\n' "${abs#/}" ;;
        *) die "path '$abs' is not absolute" ;;
      esac
      ;;
    *)
      case "$abs" in
        "$target_root"/*) printf '%s\n' "${abs#"$target_root"/}" ;;
        "$target_root") printf '\n' ;;
        *) die "path '$abs' is outside $target_root" ;;
      esac
      ;;
  esac
}

infer_source_rel() {
  local rel="$1"
  local abs="$writeback_root/$rel"
  case "$abs" in
    "$repo_root"/*) printf '%s\n' "${abs#"$repo_root"/}" ;;
    *) printf '%s\n' "$abs" ;;
  esac
}

manifest_source_rel() {
  local rel="$1"
  awk -F '\t' -v rel="$rel" '$1 == rel { print $2 }' "$manifest"
}

build_manifest() {
  local output="$1"
  local -A mapping=()
  local layer file rel source_rel

  : > "$output"
  for layer in "${layers[@]}"; do
    [ -d "$layer" ] || continue
    while IFS= read -r file; do
      rel="${file#"$layer"/}"
      case "$file" in
        "$repo_root"/*) source_rel="${file#"$repo_root"/}" ;;
        *) source_rel="$file" ;;
      esac
      mapping["$rel"]="$source_rel"
    done < <(find "$layer" -type f | sort)
  done

  for rel in "${!mapping[@]}"; do
    printf '%s\t%s\n' "$rel" "${mapping[$rel]}"
  done | sort > "$output"
}

source_path() {
  local rel="$1"
  case "$rel" in
    /*) printf '%s\n' "$rel" ;;
    *) printf '%s\n' "$repo_root/$rel" ;;
  esac
}

prune_manifest_removals() {
  local next_manifest="$1"
  local rel source_rel dst
  [ -f "$manifest" ] || return 0

  while IFS=$'\t' read -r rel source_rel; do
    [ -n "$rel" ] || continue
    if ! awk -F '\t' -v rel="$rel" '$1 == rel { found=1; exit } END { exit !found }' "$next_manifest"; then
      dst="$target_root/$rel"
      [ -e "$dst" ] && rm -f "$dst"
    fi
  done < "$manifest"
}

apply_manifest() {
  local next_manifest="${manifest}.next"
  local rel source_rel src dst

  ensure_data_dir
  build_manifest "$next_manifest"
  prune_manifest_removals "$next_manifest"
  mv "$next_manifest" "$manifest"

  while IFS=$'\t' read -r rel source_rel; do
    [ -n "$rel" ] || continue
    src="$(source_path "$source_rel")"
    dst="$target_root/$rel"
    mkdir -p "$(dirname "$dst")"
    cp -f "$src" "$dst"
  done < "$manifest"
}

maybe_git_pull() {
  if repo_git remote get-url origin >/dev/null 2>&1; then
    repo_git pull --ff-only
  fi
}

status_cmd() {
  local rel source_rel src dst dirty=false
  require_manifest
  while IFS=$'\t' read -r rel source_rel; do
    [ -n "$rel" ] || continue
    src="$(source_path "$source_rel")"
    dst="$target_root/$rel"
    if [ ! -e "$dst" ]; then
      printf ' D %s\n' "$dst"
      dirty=true
    elif ! cmp -s "$src" "$dst"; then
      printf ' M %s\n' "$dst"
      dirty=true
    fi
  done < "$manifest"
  repo_git status --short
  $dirty && return 1 || return 0
}

diff_cmd() {
  local rel source_rel src dst
  require_manifest
  while IFS=$'\t' read -r rel source_rel; do
    [ -n "$rel" ] || continue
    src="$(source_path "$source_rel")"
    dst="$target_root/$rel"
    if [ -e "$dst" ] && ! cmp -s "$src" "$dst"; then
      diff -u "$src" "$dst" || true
    fi
  done < "$manifest"
}

add_cmd() {
  local abs rel source_rel dest
  [ ${#cmd_args[@]} -eq 1 ] || die "usage: gitbooty ... add <path>"
  abs="$(canonicalize_target "${cmd_args[0]}")"
  [ -e "$abs" ] || die "path '$abs' does not exist"
  rel="$(relative_target "$abs")"
  source_rel="$(infer_source_rel "$rel")"
  dest="$(source_path "$source_rel")"
  mkdir -p "$(dirname "$dest")"
  cp -f "$abs" "$dest"
  repo_git add "$source_rel"
  ensure_data_dir
  if [ -f "$manifest" ]; then
    grep -v "^${rel}"$'\t' "$manifest" > "$manifest.tmp" || true
    mv "$manifest.tmp" "$manifest"
  fi
  printf '%s\t%s\n' "$rel" "$source_rel" >> "$manifest"
  sort -o "$manifest" "$manifest"
}

mv_cmd() {
  local src_abs dst_abs src_rel dst_rel source_rel dest_rel dest
  [ ${#cmd_args[@]} -eq 2 ] || die "usage: gitbooty ... mv <src> <dst>"
  src_abs="$(canonicalize_target "${cmd_args[0]}")"
  dst_abs="$(canonicalize_target "${cmd_args[1]}")"
  src_rel="$(relative_target "$src_abs")"
  dst_rel="$(relative_target "$dst_abs")"
  [ -e "$src_abs" ] || die "path '$src_abs' does not exist"
  source_rel=""
  [ -f "$manifest" ] && source_rel="$(manifest_source_rel "$src_rel")"
  [ -n "$source_rel" ] || die "path '$src_abs' is not tracked; use 'add' for new files"
  dest_rel="$(infer_source_rel "$dst_rel")"
  dest="$(source_path "$dest_rel")"
  if [ -e "$(source_path "$source_rel")" ]; then
    mkdir -p "$(dirname "$dst_abs")"
    mv "$src_abs" "$dst_abs"
    mkdir -p "$(dirname "$dest")"
    mv "$(source_path "$source_rel")" "$dest"
    repo_git add -A -- "$source_rel" "$dest_rel"
    awk -F '\t' -v src="$src_rel" -v dst="$dst_rel" -v newrel="$dest_rel" 'BEGIN { OFS="\t" } $1 == src { $1=dst; $2=newrel } { print }' "$manifest" > "$manifest.tmp"
    mv "$manifest.tmp" "$manifest"
  else
    die "tracked source '$source_rel' is missing from the repo"
  fi
}

sync_manifest_to_source() {
  local rel source_rel src dst
  [ -f "$manifest" ] || return 0
  while IFS=$'\t' read -r rel source_rel; do
    [ -n "$rel" ] || continue
    src="$target_root/$rel"
    dst="$(source_path "$source_rel")"
    if [ -e "$src" ]; then
      mkdir -p "$(dirname "$dst")"
      cp -f "$src" "$dst"
      repo_git add "$source_rel"
    elif [ -e "$dst" ]; then
      repo_git rm -f -- "$source_rel"
    fi
  done < "$manifest"
}

commit_cmd() {
  sync_manifest_to_source
  repo_git commit "${cmd_args[@]}"
}

push_cmd() {
  repo_git push "${cmd_args[@]}"
}

pull_cmd() {
  maybe_git_pull
  apply_manifest
}

parse_args "$@"
case "$cmd" in
  pull) pull_cmd ;;
  status) status_cmd ;;
  diff) diff_cmd ;;
  add) add_cmd ;;
  mv) mv_cmd ;;
  commit) commit_cmd ;;
  push) push_cmd ;;
  *) die "unsupported command '$cmd' (supported: pull, status, diff, add, mv, commit, push)" ;;
esac
