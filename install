#!/usr/bin/env bash
set -eo pipefail

repo_url="${BOOTY_REPO_URL:-https://github.com/briceburg/booty.git}"

command -v git >/dev/null || { echo "git is required" >&2; exit 1; }

booty_root="${BOOTY_HOME:-$HOME/.booty}"
booty_repo_root="$booty_root/booty"

if [ -d "$booty_repo_root/.git" ]; then
  git -C "$booty_repo_root" pull --ff-only
else
  mkdir -p "$(dirname "$booty_repo_root")"
  git clone "$repo_url" "$booty_repo_root"
fi

run_bootstrap(){
  BOOTY_HOME="$booty_root" "$booty_repo_root/bin/booty-bootstrap"
}

if [ ! -t 0 ] && { exec 3</dev/tty; } 2>/dev/null; then
  run_bootstrap <&3
  exec 3<&-
else
  run_bootstrap
fi
