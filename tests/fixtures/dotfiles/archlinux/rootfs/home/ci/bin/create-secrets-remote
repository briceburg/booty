#!/usr/bin/env bash
set -eo pipefail

gpg_key="$1"
[ -n "$gpg_key" ] || { echo "usage: $0 <gpg-fingerprint>" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

cp -r /work/tests/fixtures/dotfiles/secrets/. "$tmp/dotfiles/"

git -C "$tmp" init -q
git -C "$tmp" config user.email "ci@localhost"
git -C "$tmp" config user.name "CI"
git -C "$tmp" config gcrypt.participants "$gpg_key"
git -C "$tmp" add .
git -C "$tmp" commit -q -m "ci secrets"
git -C "$tmp" remote add origin "gcrypt::file:///tmp/ci-secrets-remote"
git init --bare -q /tmp/ci-secrets-remote
git -C "$tmp" push -q origin HEAD:master
